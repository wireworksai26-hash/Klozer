# Variabel layanan "backend" di Railway (Variables > Raw Editor).
# Nama layanan MySQL di bawah dianggap "MySQL"; ganti kalau Anda menamainya lain.
# Jangan commit nilai asli. File ini hanya contoh.

NODE_ENV=production
# PORT diisi Railway sendiri.

# ---- Database (referensi ke layanan MySQL, jaringan privat) ----
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# ---- Alamat publik: SAMA dengan domain VPS agar link QRIS yang sudah terkirim tidak putus ----
APP_URL=https://app.contoh.com
FRONTEND_URL=https://app.contoh.com
CORS_ORIGINS=https://app.contoh.com
# Railway -> Next (frontend) -> backend: dua lompatan proxy.
TRUST_PROXY_HOPS=2

# ---- Rahasia: HARUS sama persis dengan yang dipakai di VPS ----
JWT_SECRET=
DB_ENCRYPTION_KEY=
JWT_EXPIRES_IN=8h

# ---- WhatsApp Web (sesi disimpan di Volume yang dipasang ke /app/data/baileys) ----
BAILEYS_AUTH_DIR=/app/data/baileys
# Volume Railway dipasang sebagai root; tanpa ini user "node" di image tidak bisa menulis.
RAILWAY_RUN_UID=0

# ---- Salin dari .env VPS (kosongkan yang tidak dipakai) ----
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Platform Superadmin
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
BITESHIP_API_KEY=
PLATFORM_PAYMENT_NOTIFY_SECRET=
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_IS_PRODUCTION=false
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_FALLBACK_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Klozer <no-reply@klozer.id>
