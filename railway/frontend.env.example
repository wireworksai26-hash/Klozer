# Variabel layanan "frontend" di Railway. Ini satu-satunya layanan yang diberi domain publik.
# Isi SEBELUM build pertama: alamat backend ikut tertanam saat build.

# Jaringan privat Railway memakai nama layanan + .railway.internal. "backend" = nama layanan backend Anda.
BACKEND_INTERNAL_URL=http://backend.railway.internal:5000

# Jaringan privat Railway memakai IPv6; Next harus mendengarkan di semua alamat, bukan hanya IPv4.
HOSTNAME=::

# Kosong = satu domain untuk semuanya (/api dan /socket.io lewat frontend).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=
