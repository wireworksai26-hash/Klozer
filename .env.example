# ==============================================================================
# KLOZER - PRODUCTION CONFIGURATION (read by docker compose)
#   cp .env.example .env     then fill EVERY value marked REQUIRED.
# .env is git-ignored. Never commit it, never paste it into a chat or ticket.
# ==============================================================================

# ---- Public address ----------------------------------------------------------
# Domain pointing (A/AAAA record) at this server. Caddy gets a Let's Encrypt certificate for it.
DOMAIN=app.example.com                      # REQUIRED
ACME_EMAIL=admin@example.com                # REQUIRED: Let's Encrypt registration and expiry notices

# ---- Database (MySQL 8) ------------------------------------------------------
# Generate each with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
DB_ROOT_PASSWORD=                           # REQUIRED  (root, used only by compose/restore)
DB_NAME=klozer_db
DB_USER=klozer_user
DB_PASSWORD=                                # REQUIRED  (>= 12 chars; the app user, owns only DB_NAME)
BACKUP_RETENTION_DAYS=14

# ---- Application secrets -----------------------------------------------------
# The server REFUSES to start in production if these are missing, short, or placeholders.
JWT_SECRET=                                 # REQUIRED  openssl rand -hex 48
JWT_EXPIRES_IN=8h
DB_ENCRYPTION_KEY=                          # REQUIRED  openssl rand -hex 32  (64 hex chars)
                                            # Encrypts WhatsApp/Meta tokens at rest. LOSING THIS KEY MAKES
                                            # THOSE TOKENS UNREADABLE: back it up separately from the database.

# First platform administrator. Created once, only if no superadmin exists yet.
# After the first successful start you may blank SUPERADMIN_PASSWORD.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=                        # >= 12 characters
SUPERADMIN_NAME=Platform Superadmin

# ---- WhatsApp Cloud API (Meta) ----------------------------------------------
# Per-tenant numbers/tokens are configured inside the app (Settings > WhatsApp).
# These two are platform-wide and verify that webhook calls really come from Meta.
META_APP_SECRET=                            # Meta App > Settings > Basic > App Secret
META_WEBHOOK_VERIFY_TOKEN=                  # any long random string you also enter in Meta's webhook setup
META_GRAPH_VERSION=v21.0
# Webhook URL to register in Meta:  https://<DOMAIN>/api/v1/webhooks/whatsapp

# ---- Payments (iPaymu) ---------------------------------------------------------
# Leave blank to disable QRIS payments. Sandbox and production have DIFFERENT VA and API key.
# In the iPaymu dashboard set the callback (notify) URL to:
#   https://<DOMAIN>/api/v1/payments/webhook
# and the callback content type to application/json.
# Payment notices for Klozer's own bills (package and token top up). A forwarder (n8n, a bank or e-wallet feed) posts the
# amount received to /api/v1/payments/platform-notify with this value in the X-Notify-Secret header, and the matching
# bill is settled by itself. Empty switches this off; the team then confirms payments by hand. Make one: openssl rand -hex 32
PLATFORM_PAYMENT_NOTIFY_SECRET=
IPAYMU_VA=                                  # merchant VA number (also the secret that signs callbacks)
IPAYMU_API_KEY=
IPAYMU_IS_PRODUCTION=false                  # "true" only with the production VA and API key

# Live courier rates and tracking for orders taken in chat (optional, biteship.com).
BITESHIP_API_KEY=

# ---- AI providers ------------------------------------------------------------
# At least one key is needed for AI replies. Without any, conversations are handed to a human.
AI_PROVIDER=nvidia                          # primary: nvidia | gemini (the other is the failover)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_FALLBACK_MODEL=meta/llama-3.1-8b-instruct         # used when the model above fails
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct   # reads payment-proof images
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite           # used when the model above fails

# ---- Email (optional) ---------------------------------------------------------
# Without SMTP, signup credentials are shown once on screen only (never logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Klozer <no-reply@example.com>
