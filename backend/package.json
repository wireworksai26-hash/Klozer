{
  "name": "klozer-backend",
  "version": "1.0.0",
  "description": "Next-Gen AI Conversational Commerce & Smart CRM Backend Engine",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seeds.js",
    "lint": "eslint src test",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 --test-reporter=spec \"test/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.16.2",
    "nodemailer": "^10.0.16",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
