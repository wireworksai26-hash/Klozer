# ==============================================================================
# KLOZER BACKEND - LOCAL DEVELOPMENT (.env.example)
#   cp .env.example .env
# For production use the root .env.example with docker compose instead.
# .env is git-ignored. Never commit real credentials.
# ==============================================================================

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Database ----------------------------------------------------------------
# In development the database is created automatically if it does not exist.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=klozer_db

# ---- Secrets -----------------------------------------------------------------
# Development falls back to built-in values when these are empty. Production does NOT: the
# server refuses to start without strong values.
#   JWT_SECRET:         node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   DB_ENCRYPTION_KEY:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
DB_ENCRYPTION_KEY=

# Optional: create a superadmin on first start (otherwise run `npm run seed` for demo data).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ---- Integrations (all optional locally) ---------------------------------------
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_IS_PRODUCTION=false
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
GEMINI_API_KEY=
# 0 to 1. Default 0.65 gives natural, varied chat replies; lower it if answers drift.
# AI_TEMPERATURE=0.65

# ---- Behaviour ---------------------------------------------------------------
LOG_LEVEL=debug
# RUN_MIGRATIONS_ON_START=false     # set false if you run `npm run migrate` as a separate deploy step
