# ==============================================================================
# KLOZER BACKEND CONFIGURATION TEMPLATE (.env.example)
# Duplicate this file as '.env' and fill in your private API credentials
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=your_ultra_secure_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
DB_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here_0123456789abcdef

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=klozer_db

# Meta WhatsApp Cloud API (Official Meta Developer Credentials)
META_WABA_PHONE_NUMBER_ID=your_waba_phone_number_id
META_ACCESS_TOKEN=your_permanent_system_user_meta_access_token
META_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token
META_PIXEL_ID=your_meta_pixel_id
META_CAPI_ACCESS_TOKEN=your_meta_conversions_api_access_token

# Payment Gateway (Xendit / Midtrans Sandbox/Production)
PAYMENT_GATEWAY_PROVIDER=xendit
PAYMENT_GATEWAY_SECRET_KEY=xnd_development_your_secret_key
PAYMENT_GATEWAY_WEBHOOK_SECRET=xnd_whsec_your_webhook_verification_token

# AI Model Configuration (Google Gemini Flash Lite)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
NVIDIA_API_KEY=your_nvidia_nim_api_key
OPENAI_API_KEY=your_openai_api_key
