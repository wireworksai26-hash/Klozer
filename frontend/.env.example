# ==============================================================================
# KLOZER FRONTEND (.env.local), all optional
# By default the browser calls /api and /socket.io on its own origin:
#   - development: next.config.mjs forwards them to BACKEND_INTERNAL_URL
#   - production:  the reverse proxy (Caddy) forwards them to the backend
# ==============================================================================

# Where `next dev` / `next start` forward /api and /socket.io (server side only)
BACKEND_INTERNAL_URL=http://localhost:5000

# Only if the API lives on a different origin from the site. Baked in at build time.
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# NEXT_PUBLIC_SOCKET_URL=https://api.example.com
